[Unit]
Description=RedstoneDB
After=network-online.target
Wants=network-online.target

[Service]
User=redstonedb
Group=redstonedb
EnvironmentFile=/etc/redstonedb.env
WorkingDirectory=/var/lib/redstonedb
ExecStart=/usr/local/lib/redstonedb/redstone-database
Restart=on-failure
RestartSec=2

# The site writes only its database.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/redstonedb
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
