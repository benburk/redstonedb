DATABASE_URL=sqlite:redstone.db

# Compile against the query metadata in .sqlx/ rather than a live database,
# so building and linting need no database at all. Run `just prepare` after
# changing a query.
SQLX_OFFLINE=true

# Discord login. The ID is public; the secret comes from the Discord
# Developer Portal (OAuth2 > Client Secret) and never goes in git. The
# redirect must also be listed on that page, exactly as written here.
DISCORD_CLIENT_ID=1557512599057211402
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/auth/discord/callback

# Where `just deploy`, `pull-db`, `logs`, and `status` reach the live site,
# as user@host.
DEPLOY_HOST=

# On a development build, every request is signed in as this account, if it
# exists. Leave it empty to see the site signed out.
DEV_USER=embizone
