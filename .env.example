# Settings of your own. A fresh checkout runs without any of them, on the
# development settings in .cargo/config.toml, and any set here wins over
# those.

# Discord login's secret, from the Discord Developer Portal (OAuth2 > Client
# Secret), which never goes in git. Without it the site runs with login
# turned off.
DISCORD_CLIENT_SECRET=

# Where `just deploy`, `pull-db`, `logs`, and `status` reach the live site,
# as user@host.
DEPLOY_HOST=

# The account every request on a development build is signed in as, such as
# your own in a pull of the live database; empty to see the site signed out.
# DEV_USER=
